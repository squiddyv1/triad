+++ b/cairn/src/cairn/dispatcher/workers/adapters/opencode.py
@@ -0,0 +1,175 @@
+"""OpenCode worker driver.
+
+Adds `type: opencode` as a Cairn worker backend, so the dispatcher can reuse a
+host `opencode` CLI (and its already-configured providers) instead of requiring
+Claude Code, Codex or Pi.
+
+Why this exists: on hosts where only opencode is installed and authenticated,
+none of the shipped backends can run, so the whole exploitation layer is blocked.
+opencode is OpenAI-compatible, speaks JSON events, and supports session
+continuation, which is all the worker protocol needs.
+
+Verified against opencode 1.18.34, local execution mode:
+  opencode run --format json [--model provider/model] [-s SESSION] [--auto] "<prompt>"
+  -> JSONL events on stdout, e.g.
+     {"type":"step_start","sessionID":"ses_..."}
+     {"type":"text","part":{"type":"text","text":"{...}"}}
+     {"type":"step_finish","part":{"tokens":{...},"cost":0.0017}}
+
+Env keys (per worker):
+  OPENCODE_MODEL          provider/model for --model, e.g. opencode-go/deepseek-v4.1-flash
+                          (optional in local mode: omit to use the host default model)
+  OPENCODE_AGENT          agent name for --agent, e.g. build
+  OPENCODE_AUTO           "1" (default) -> pass --auto so headless runs can use tools.
+                          Set "0" to leave permission prompts in place.
+  OPENCODE_BASE_URL       OpenAI-compatible base URL (container mode / health check)
+  OPENCODE_API_KEY        bearer token for that base URL
+  OPENCODE_EXTRA_HEADERS  JSON object; "$SESSION" is replaced with a fresh uuid per
+                          invocation, e.g. {"x-opencode-session":"$SESSION"}
+  OPENCODE_CONFIG_CONTENT_JSON
+                          Container mode only: exact OPENCODE_CONFIG_CONTENT to export,
+                          for images that need a provider injected. Deliberately not
+                          synthesised here: the provider-config schema varies by
+                          opencode version, and guessing it silently breaks runs.
+
+Container mode is *not* verified on this machine: Cairn's worker image does not
+ship opencode, so container deployments must either install it in a derived image
+or use local mode (recommended on arm64, where that image is unavailable anyway).
+"""
+
+from __future__ import annotations
+
+import json
+import uuid
+from typing import Any
+
+from cairn.dispatcher.config import WorkerConfig
+from cairn.dispatcher.workers.base import DriverResult, WorkerDriver
+from cairn.dispatcher.workers.health import HealthResult, http_ping, proxies_from_env
+
+
+class OpenCodeDriver(WorkerDriver):
+    type_name = "opencode"
+
+    def __init__(self, local: bool = False):
+        self.local = local
+
+    def local_binary(self) -> str | None:
+        return "opencode"
+
+    # ---- health ----------------------------------------------------------
+    def check_health(self, worker: WorkerConfig, *, timeout: float) -> HealthResult:
+        env = worker.env
+        base = env["OPENCODE_BASE_URL"].rstrip("/")
+        api_model = self._api_model(env["OPENCODE_MODEL"])
+        headers = {
+            "Authorization": f"Bearer {env['OPENCODE_API_KEY']}",
+            "content-type": "application/json",
+            **self._extra_headers(env),
+        }
+        return http_ping(
+            f"{base}/chat/completions",
+            headers=headers,
+            json_body={"model": api_model, "max_tokens": 10,
+                       "messages": [{"role": "user", "content": "ping"}]},
+            timeout=timeout,
+            proxies=proxies_from_env(env),
+        )
+
+    def describe_health(self, worker: WorkerConfig) -> str:
+        env = worker.env
+        return f"POST {env['OPENCODE_BASE_URL']}/chat/completions (model={env['OPENCODE_MODEL']})"
+
+    # ---- argv ------------------------------------------------------------
+    def build_execute(self, worker: WorkerConfig, prompt: str, session: str | None) -> DriverResult:
+        return DriverResult(argv=self._argv(worker, prompt, session), session=session)
+
+    def build_conclude(self, worker: WorkerConfig, prompt: str, session: str) -> list[str]:
+        return self._argv(worker, prompt, session)
+
+    def _argv(self, worker: WorkerConfig, prompt: str, session: str | None) -> list[str]:
+        env = worker.env
+        # The binary is part of argv in BOTH modes: local mode execs this command
+        # verbatim, and container mode prepends its own wrapper around it.
+        # (Omitting it fails with `FileNotFoundError: 'run'` at task time.)
+        argv = ["opencode", "run", "--format", "json"]
+        model = (env.get("OPENCODE_MODEL") or "").strip()
+        if model:
+            argv += ["--model", model]
+        agent = (env.get("OPENCODE_AGENT") or "").strip()
+        if agent:
+            argv += ["--agent", agent]
+        if env.get("OPENCODE_AUTO", "1") != "0":
+            argv += ["--auto"]
+        if session:
+            argv += ["-s", session]
+        argv.append(prompt)
+
+        config = (env.get("OPENCODE_CONFIG_CONTENT_JSON") or "").strip()
+        if config and not self.local:
+            # Export the caller-supplied config, then exec the real CLI.
+            script = 'export OPENCODE_CONFIG_CONTENT="$1"\nshift\nexec opencode "$@"\n'
+            return ["/bin/sh", "-lc", script, "--", config, *argv]
+        return argv
+
+    # ---- output parsing --------------------------------------------------
+    def extract_session(self, session: str | None, stdout: str, stderr: str) -> str | None:
+        if session:
+            return session
+        for event in self._iter_events(stdout):
+            session_id = event.get("sessionID")
+            if isinstance(session_id, str) and session_id:
+                return session_id
+        return None
+
+    def extract_response_text(self, stdout: str, stderr: str) -> str:
+        parts: list[str] = []
+        for event in self._iter_events(stdout):
+            if event.get("type") != "text":
+                continue
+            part = event.get("part")
+            if not isinstance(part, dict) or part.get("type") != "text":
+                continue
+            text = part.get("text")
+            if isinstance(text, str) and text.strip():
+                parts.append(text)
+        if parts:
+            return "\n".join(parts)
+        # No parsed events: pydantic-free fallback so the dispatcher's own
+        # JSON extractor still gets a chance at raw stdout.
+        return stdout
+
+    @staticmethod
+    def _iter_events(stdout: str) -> list[dict[str, Any]]:
+        events: list[dict[str, Any]] = []
+        for line in stdout.splitlines():
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                payload = json.loads(line)
+            except json.JSONDecodeError:
+                continue
+            if isinstance(payload, dict):
+                events.append(payload)
+        return events
+
+    # ---- helpers ---------------------------------------------------------
+    @staticmethod
+    def _api_model(model: str) -> str:
+        """`provider/model` (opencode id) -> `model` (wire id)."""
+        return model.split("/", 1)[1] if "/" in model else model
+
+    @staticmethod
+    def _extra_headers(env: dict[str, str]) -> dict[str, str]:
+        raw = (env.get("OPENCODE_EXTRA_HEADERS") or "").strip()
+        if not raw:
+            return {}
+        try:
+            parsed = json.loads(raw)
+        except json.JSONDecodeError:
+            return {}
+        if not isinstance(parsed, dict):
+            return {}
+        session = str(uuid.uuid4())
+        return {str(k): str(v).replace("$SESSION", session) for k, v in parsed.items()}
