diff --git a/cairn/tests/test_opencode_adapter.py b/cairn/tests/test_opencode_adapter.py
new file mode 100644
index 0000000..24da687
--- /dev/null
+++ b/cairn/tests/test_opencode_adapter.py
@@ -0,0 +1,130 @@
+"""Tests for the opencode worker backend added by this repo.
+
+Upstream Cairn ships claudecode / codex / pi / mock. The opencode driver exists so
+a host with only the opencode CLI (no claude/codex/pi) can still run workers.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+from pydantic import ValidationError
+
+from cairn.dispatcher.config import DispatchConfig
+from cairn.dispatcher.workers.adapters.opencode import OpenCodeDriver
+from cairn.dispatcher.workers.registry import DRIVERS, LOCAL_DRIVERS, get_driver
+
+from conftest import make_config
+
+OPENCODE_ENV = {
+    "OPENCODE_MODEL": "opencode-go/deepseek-v4.1-flash",
+    "OPENCODE_BASE_URL": "https://gateway.example/v1",
+    "OPENCODE_API_KEY": "secret",
+}
+
+
+def _worker(**env_overrides):
+    from cairn.dispatcher.config import WorkerConfig
+
+    return WorkerConfig.model_validate({
+        "name": "oc",
+        "type": "opencode",
+        "task_types": ["bootstrap", "reason", "explore"],
+        "max_running": 1,
+        "priority": 0,
+        "env": {**OPENCODE_ENV, **env_overrides},
+    })
+
+
+def test_opencode_is_registered_in_both_execution_modes() -> None:
+    assert "opencode" in DRIVERS
+    assert "opencode" in LOCAL_DRIVERS
+    assert isinstance(get_driver("opencode", "local"), OpenCodeDriver)
+    assert get_driver("opencode", "local").local_binary() == "opencode"
+
+
+def test_opencode_execute_argv_carries_model_json_format_and_prompt() -> None:
+    argv = OpenCodeDriver().build_execute(_worker(), "# Task\nbody", None).argv
+
+    assert argv[:4] == ["opencode", "run", "--format", "json"]
+    assert argv[argv.index("--model") + 1] == "opencode-go/deepseek-v4.1-flash"
+    assert "--auto" in argv          # headless: workers must be able to use tools
+    assert argv[-1] == "# Task\nbody"
+    assert "-s" not in argv          # no session on the first call
+
+
+def test_opencode_auto_can_be_disabled_and_session_is_continued() -> None:
+    argv = OpenCodeDriver().build_execute(_worker(OPENCODE_AUTO="0"), "p", None).argv
+    assert "--auto" not in argv
+
+    argv = OpenCodeDriver().build_conclude(_worker(), "p", "ses_123")
+    assert argv[argv.index("-s") + 1] == "ses_123"
+    assert argv[-1] == "p"
+
+
+def test_opencode_agent_flag_is_optional() -> None:
+    assert "--agent" not in OpenCodeDriver().build_execute(_worker(), "p", None).argv
+    argv = OpenCodeDriver().build_execute(_worker(OPENCODE_AGENT="build"), "p", None).argv
+    assert argv[argv.index("--agent") + 1] == "build"
+
+
+def test_opencode_parses_session_id_and_text_events() -> None:
+    stdout = "\n".join([
+        json.dumps({"type": "step_start", "sessionID": "ses_abc", "part": {}}),
+        json.dumps({"type": "text", "sessionID": "ses_abc",
+                    "part": {"type": "text", "text": '{"accepted":true}'}}),
+        json.dumps({"type": "step_finish", "sessionID": "ses_abc",
+                    "part": {"tokens": {"total": 12}, "cost": 0.01}}),
+        "not json at all",
+    ])
+
+    driver = OpenCodeDriver()
+    assert driver.extract_session(None, stdout, "") == "ses_abc"
+    assert driver.extract_session("ses_keep", stdout, "") == "ses_keep"
+    assert driver.extract_response_text(stdout, "") == '{"accepted":true}'
+    # Unparseable output must fall through to the raw text, not vanish.
+    assert driver.extract_response_text("plain text", "") == "plain text"
+
+
+def test_opencode_extra_headers_mint_a_fresh_session_per_call() -> None:
+    driver = OpenCodeDriver()
+    env = {"OPENCODE_EXTRA_HEADERS": '{"x-session":"$SESSION","UA":"oc"}'}
+
+    first = driver._extra_headers(env)
+    second = driver._extra_headers(env)
+
+    assert first["UA"] == "oc"
+    assert first["x-session"] != "$SESSION"
+    assert first["x-session"] != second["x-session"]
+    assert driver._extra_headers({"OPENCODE_EXTRA_HEADERS": "not json"}) == {}
+
+
+def test_opencode_wire_model_strips_the_provider_prefix() -> None:
+    driver = OpenCodeDriver()
+    assert driver._api_model("opencode-go/deepseek-v4.1-flash") == "deepseek-v4.1-flash"
+    assert driver._api_model("bare-model") == "bare-model"
+
+
+def test_opencode_container_mode_requires_llm_env_keys() -> None:
+    payload = make_config().model_dump()
+    payload["workers"] = [{
+        "name": "oc", "type": "opencode", "task_types": ["explore"],
+        "max_running": 1, "priority": 0,
+        "env": {"OPENCODE_MODEL": "m"},          # base URL + key missing
+    }]
+
+    with pytest.raises(ValidationError, match="missing env keys"):
+        DispatchConfig.model_validate(payload)
+
+
+def test_opencode_local_mode_needs_no_llm_env_keys() -> None:
+    payload = make_config().model_dump()
+    payload["runtime"]["execution"] = "local"
+    payload["workers"] = [{
+        "name": "oc", "type": "opencode", "task_types": ["explore"],
+        "max_running": 1, "priority": 0, "env": {},
+    }]
+
+    config = DispatchConfig.model_validate(payload)
+    assert config.workers[0].type == "opencode"
