# Triad: copy to .env and fill in. Never commit the filled file.

# ---- LLM keys used by the dispatcher's worker containers -------------------
ANTHROPIC_AUTH_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---- Strix (discovery layer) ----------------------------------------------
# Any LiteLLM model id. GLM-5.3 is Strix's tuned default; DeepSeek-V4-Pro is
# cheaper and its tool calling is sound.
STRIX_LLM="openrouter/z-ai/glm-5.3"
LLM_API_KEY=
STRIX_TELEMETRY=0

# ---- Hermes control plane --------------------------------------------------
CAIRN_BASE_URL=http://127.0.0.1:8000
TRIAD_WORKDIR=~/engagements

# ---- Engagement ------------------------------------------------------------
ENGAGEMENT_ID=

# ---- Binding ---------------------------------------------------------------
# Where the Cairn web console + API is published.
#   0.0.0.0  reachable from the host/LAN (convenient, note the exposure)
#   127.0.0.1  loopback only (safer; set this if you tunnel in over SSH)
CAIRN_BIND=0.0.0.0
