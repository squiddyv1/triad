# Triad: copy to .env and fill in. Never commit the filled file.
#
# You normally do not edit this by hand: `triad setup` fills it in, and
# `triad configure` changes the models later. Editing it directly works too.

# ---- Model keys ------------------------------------------------------------
# One key usually serves both layers, and `triad setup` writes it to whichever
# of these belongs to the provider you chose. OPENCODE_GO_API_KEY and
# OPENROUTER_API_KEY are also copied into opencode's own credentials file, since
# the bundled worker reads that instead of the environment.
OPENCODE_GO_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=

# ---- Strix (discovery layer) ----------------------------------------------
# Any LiteLLM model id. GLM-5.3 is Strix's tuned default; DeepSeek-V4-Pro is
# cheaper and its tool calling is sound.
STRIX_LLM="openrouter/z-ai/glm-5.3"
LLM_API_KEY=
STRIX_TELEMETRY=0

# For an OpenAI-compatible endpoint instead of a first-class provider, use
# openai/<model> plus the endpoint. Some endpoints also reject a bare client and
# need headers, for example OpenCode Go:
#   STRIX_LLM="openai/deepseek-v4.1-flash"
#   LLM_API_BASE="https://opencode.ai/zen/go/v1"
#   LLM_EXTRA_HEADERS='{"User-Agent":"strix-agent","x-opencode-session":"triad-<uuid>"}'
# `triad setup` or `triad configure` writes all three when you pick that provider.
LLM_API_BASE=
LLM_EXTRA_HEADERS=

# ---- Cairn ----------------------------------------------------------------
# The API and the dispatcher that works the graph. The dispatcher's worker model
# is set in the dispatcher config rather than here: `triad configure` writes
# .triad/dispatch.local.yaml for that, and dispatch.local.yaml is the template.
CAIRN_BASE_URL=http://127.0.0.1:8000
TRIAD_WORKDIR=~/engagements

# ---- Engagement ------------------------------------------------------------
ENGAGEMENT_ID=

# ---- Binding ---------------------------------------------------------------
# Where the Cairn web console + API is published.
#   0.0.0.0  reachable from the host/LAN (convenient, note the exposure)
#   127.0.0.1  loopback only (safer; set this if you tunnel in over SSH)
CAIRN_BIND=0.0.0.0
